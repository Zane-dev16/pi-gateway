{
  "name": "@irellzane/pi-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Messaging gateway for the pi coding agent (Hermes Gateway parity).",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check:layering": "node scripts/check-layering.mjs",
    "check:secrets": "node scripts/check-secret-scope.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
